# Firebase Configuration (for frontend)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# Optional: Secret for cron endpoint
CRON_SECRET=your_cron_secret_here

# Optional: Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# Port
PORT=3000

# Upstash Redis
UPSTASH_REDIS_REST_URL=https://your-instance-id.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here

# Stripe (for Pro tier)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_ID=price_your_price_id # Price ID for Pro subscription

# Google AI API Key (for LLM-powered verification)
GOOGLE_API_KEY=your_google_api_key_here

# Conway Automaton — Sovereign AI agent integration
# Bootstrap the runtime alongside PRISM with one of:
#   npm run automaton:up        (bash / WSL / macOS / Linux)
#   scripts\bootstrap-automaton.bat   (Windows native cmd)
#
# That script clones Conway-Research/automaton into ./automaton/, installs,
# builds, and starts the runtime on AUTOMATON_PORT (default 7777). It then
# patches this .env so AUTOMATON_BASE_URL points at the live process.
#
# With AUTOMATON_BASE_URL set, /api/automaton/* endpoints proxy to the
# sovereign runtime; with it empty, they return sandbox stubs.
AUTOMATON_BASE_URL=
AUTOMATON_API_KEY=
AUTOMATON_PORT=7777