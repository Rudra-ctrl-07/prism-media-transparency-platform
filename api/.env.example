# Firebase Service Account (as JSON string)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project-id","private_key_id":"","private_key":"-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n","client_email":"your-service-account@your-project-id.iam.gserviceaccount.com","client_id":"","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/your-service-account%40your-project-id.iam.gserviceaccount.com"}

# Optional: Secret for cron endpoint
CRON_SECRET=your_cron_secret_here

# Optional: Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# Port
PORT=3000

# Upstash Redis
UPSTASH_REDIS_REST_URL=https://your-instance-id.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here

# Stripe (for Pro tier)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_ID=price_your_price_id # Price ID for Pro subscription

# Google AI API Key (for LLM-powered verification)
GOOGLE_API_KEY=your_google_api_key_here

# 24/7 Earnings Loop (api/src/loop)
# --------------------------------
# Seconds between loop ticks (default 21600 = every 6h; min 60 for testing)
EARNINGS_LOOP_INTERVAL_SECONDS=21600
# Set to false to skip running the content agent on each tick
EARNINGS_LOOP_AGENT=true
# Set to false to skip automaton supervision (spawn/restart of the runtime)
EARNINGS_LOOP_AUTOMATON=true
# Data dir for loop state + earnings reports (default <PRISM_ROOT>/data/loop)
EARNINGS_DATA_DIR=
# Project root used to locate ./automaton (defaults to process.cwd())
PRISM_ROOT=

# Conway Automaton — sovereign runtime checkout location
AUTOMATON_DIR=